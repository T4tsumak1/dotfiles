configuration {
    modi:                   "drun,filebrowser,window,run";
    font:                   "JetBrainsMono Nerd Font Medium 10";
    show-icons:             true;
    icon-theme:             "oomox-gruvbox-dark";
    display-drun:           " ";
    display-run:            " ";
    display-filebrowser:    " ";
    display-window:         " ";
    drun-display-format:    "{icon} {name}";
    hover-select:           false;
    scroll-method:          1;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
    window-format:          "{w} · {c} · {t}";
    fake-transparency:      true;
}

//@theme "/usr/share/rofi/themes/gruvbox-dark-hard.rasi"
@theme "~/.config/rofi/actualTheme.rasi"

window {
    //height:                      12em;
    //width:                       56em;
    width:                       30%;
    //transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0em;
    padding:                     0em;
    border:                      5px;
    border-color:                transparent;// @border-color; // è un altro questo #1a110f;
    border-radius:               0.2em;
    background-color:            transparent;
}


mainbox {
    enabled:                true;
    spacing:                0em;
    padding:                0em;
    orientation:            "vertical";
    children:               [ "inputbar", "listbox" ];
    background-color:       transparent;
    //background-image:
}


// inputs
inputbar {
    enabled:                true;
    spacing:                0em;
    padding:                0em;
    children:               [ "textbox-prompt-colon", "entry" ];
    background-color:       transparent;
}


textbox-prompt-colon {
    enabled:                true;
    expand:                 false;
    str:                    "  ";
    padding:                1em 0.2em 0em 0em;
    text-color:             @text-color;
    border-radius:          0em 0em 0em 0em;
    background-color:       @background-color; //rgba(0,0,0,0.8);  //rgba(33, 41, 34, 0.89);
}


entry {
    enabled:                true;
    border-radius:          0em 0em 0em 0em;
    spacing:                1em;
    padding:                1em;
    background-color:       @background-color; //rgba(0,0,0,0.8);  //rgba(33, 41, 34, 0.89);
    text-color:             @text-color;
    cursor:                 text;
    placeholder:            "Search";
    placeholder-color:      inherit;
}


// list
listbox {
    padding:                0em;
    spacing:                0em;
    orientation:            horizontal;
    children:               [ "listview" , "mode-switcher" ];
    background-color:       @background-color; //rgba(0,0,0,0.8);
}


listview {
    padding:                     1.5em;
    spacing:                     0.5em;
    enabled:                     true;
    columns:                     1;
    lines:                       5;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @text-color;
}


// Modes //
mode-switcher {
    orientation:                 vertical;
    width:                       6em;
    enabled:                     true;
    padding:                     1.5em;
    spacing:                     1.5em;
    background-color:            transparent;
}

button {
    cursor:                      pointer;
    border-radius:               0.4em;
    background-color:            @background-color; //rgba(33, 41, 34, 0.8);
    text-color:                  @text-color;
}

button selected {
    background-color:            @select-bg; //rgba(86,90,87,0.89);
    text-color:                  @text-color;
}


// Elements //
element {
    enabled:                     true;
    spacing:                     0em;
    padding:                     0.5em;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @text-color;
}

element selected.normal {
    background-color:            @select-bg; //rgba(86,90,87,0.89);
    text-color:                  @text-color;
    border-radius:               0em;
}

element normal.normal {
    background-color:            inherit;
    text-color:                  @text-color;
}

element normal.urgent {
    background-color:            inherit;
    text-color:                  @text-color;
}

element normal.active {
    background-color:            inherit;
    text-color:                  @text-color;
}

element selected.urgent {
    background-color:            inherit;
    text-color:                  @text-color;
}

element selected.active {
    background-color:            inherit;
    text-color:                  @text-color;
}

element alternate.normal {
    background-color:            inherit;
    text-color:                  @text-color;
}

element alternate.urgent {
    background-color:            inherit;
    text-color:                  @text-color;
}

element alternate.active {
    background-color:            inherit;
    text-color:                  @text-color;
}

element-icon {
    size:                        1.5em;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
    border-radius:               0em 0em 0em 0em;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.1;
    border-radius:               0em;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

// Error message //
error-message {
    text-color:                  @text-color;
    background-color:            rgba(68,42,33,0.7);
    text-transform:              capitalize;
    children:                    [ "textbox" ];
}

textbox {
    text-color:                  inherit;
    background-color:            inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
